{
  "name": "@galvao/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    }
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@galvao/tsconfig": "workspace:*",
    "@types/node": "^22.19.19",
    "drizzle-kit": "^0.31.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
