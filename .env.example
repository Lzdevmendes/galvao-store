# ═══════════════════════════════════════════════════════════════════════════════
#  Galvão's Store — variáveis de ambiente
#  Copie este ficheiro para apps/store/.env.local e apps/admin/.env.local
#  e preencha cada valor conforme as instruções.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Supabase (Auth + Storage) ──────────────────────────────────────────────────
# Obter em: supabase.com → projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # apenas admin

# ── Turso (banco de dados) ────────────────────────────────────────────────────
# Dev local: omitir (usa file:../../packages/db/galvao.db automaticamente)
# Produção: turso.tech → criar DB → obter URL e token
DATABASE_URL=libsql://galvao-store.turso.io
DATABASE_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# ── URLs da aplicação ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3010          # produção: https://galvaosstore.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3010           # igual ao SITE_URL
STORE_URL=http://localhost:3010                     # usado pelo admin para links

# ── Mercado Pago ──────────────────────────────────────────────────────────────
# Obter em: mercadopago.com.br → Desenvolvedores → Credenciais
# Sandbox: começa com TEST- | Produção: começa com APP_USR-
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxx       # configurar em MP → Webhooks

# ── Resend (e-mails transacionais) ────────────────────────────────────────────
# Obter em: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── WhatsApp Business API ─────────────────────────────────────────────────────
# Obter em: developers.facebook.com → App → WhatsApp → API Setup
WHATSAPP_PHONE_ID=1234567890123456
WHATSAPP_TOKEN=EAAxxxxxxxxxxxx

# ── Melhor Envio (frete Correios) ─────────────────────────────────────────────
# Obter em: melhorenvio.com.br → Integrações → API
MELHOR_ENVIO_CLIENT_ID=xxxx
MELHOR_ENVIO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
MELHOR_ENVIO_SANDBOX=true                           # false em produção
SHIPPING_ORIGIN_CEP=11671207                        # CEP da loja

# ── Upstash Redis (rate limiting — opcional) ──────────────────────────────────
# Sem estas variáveis o rate limiting funciona em memória (dev ok, prod não ideal)
# Obter em: upstash.com → criar DB Redis → REST API
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxx

# ── Analytics (opcionais) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# ── Redes sociais (opcionais) ─────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_PHONE=5512999999999            # ex: 55 + DDD + número
NEXT_PUBLIC_INSTAGRAM=galvaosstore
NEXT_PUBLIC_FACEBOOK=galvaosstore

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@galvaosstore.com.br              # vírgula para múltiplos

# ── Cron jobs ─────────────────────────────────────────────────────────────────
# Segredo para proteger endpoints /api/cron/* (Vercel Cron)
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
